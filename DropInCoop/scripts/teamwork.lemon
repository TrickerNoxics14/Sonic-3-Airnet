global u8 option.dropin.checkpoints
global u8 option.dropin.regroup
global u8 option.dropin.team_moves
global u16 dropin.rescue_hold1
global u16 dropin.rescue_hold2
global u16 dropin.rescue_cooldown
global bool dropin.team_boss
global u16 dropin.regroup_pending
global bool dropin.team_checkpoint_valid
global u16 dropin.team_checkpoint_zone
global u8 dropin.team_checkpoint_number
global u16 dropin.team_checkpoint_x
global u16 dropin.team_checkpoint_y
global u16 dropin.team_checkpoint_layer
global u16 dropin.team_checkpoint_sprite
global u8 dropin.team_checkpoint_height
global bool dropin.team_checkpoint_gravity
global u8 dropin.team_checkpoint_profile
global u32 dropin.checkpoint_activator
global u16 dropin.team_combo
global u16 dropin.team_combo_timer
global u16 dropin.team_card_timer
global u8 dropin.team_card
global u8 dropin.team_rescues
global u8 dropin.team_launches
global u8 dropin.team_insurance_saves
global u8 dropin.team_insurance_charges
