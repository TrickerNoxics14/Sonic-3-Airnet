+# Compares the four views of a four-view picture with pictures of the same cameras rendered by the game as one ordinary full screen view
+# (the harness saves them as <prefix>-ref0.bmp ... ref3.bmp, with the world and the cameras frozen). Where the picture of a view and its
+# reference are the same, the four-view renderer drew the same level at the same place. Returns, for each view, the share of compared
+# pixels that are equal (colour channels within a small tolerance), or $null if a picture is missing.
+# The compared part of a view leaves out its top (the game's HUD, the view's label) and its bottom (labels and hints written over the views).
+Add-Type -ReferencedAssemblies System.Drawing -TypeDefinition @"
+using System;
+using System.Drawing;
+using System.Drawing.Imaging;
+public static class QuadReferenceCompare
+{
+	static byte[] Load(string path, out int width, out int height)
+	{
+		using (Bitmap source = new Bitmap(path))
+		using (Bitmap bitmap = new Bitmap(source.Width, source.Height, PixelFormat.Format32bppArgb))
+		{
+			using (Graphics g = Graphics.FromImage(bitmap)) { g.DrawImage(source, 0, 0, source.Width, source.Height); }
+			width = bitmap.Width; height = bitmap.Height;
+			BitmapData data = bitmap.LockBits(new Rectangle(0, 0, width, height), ImageLockMode.ReadOnly, PixelFormat.Format32bppArgb);
+			byte[] bytes = new byte[data.Stride * height];
+			System.Runtime.InteropServices.Marshal.Copy(data.Scan0, bytes, 0, bytes.Length);
+			bitmap.UnlockBits(data);
+			return bytes;
+		}
+	}
+	public static double Compare(string quadPath, string refPath, int view, int topSkip, int bottomSkip, int tolerance)
+	{
+		int qw, qh, rw, rh;
+		byte[] quad = Load(quadPath, out qw, out qh);
+		byte[] reference = Load(refPath, out rw, out rh);
+		int viewW = qw / 2, viewH = qh / 2;
+		int x0 = (view & 1) * viewW, y0 = (view >> 1) * viewH;
+		if (rw < viewW || rh < viewH) return -1;
+		long equal = 0, total = 0;
+		for (int row = topSkip; row < viewH - bottomSkip; ++row)
+		{
+			for (int col = 0; col < viewW; ++col)
+			{
+				int a = ((y0 + row) * qw + x0 + col) * 4;
+				int b = (row * rw + col) * 4;
+				bool same = Math.Abs(quad[a] - reference[b]) <= tolerance && Math.Abs(quad[a + 1] - reference[b + 1]) <= tolerance && Math.Abs(quad[a + 2] - reference[b + 2]) <= tolerance;
+				if (same) ++equal;
+				++total;
+			}
+		}
+		return total == 0 ? -1 : (double)equal / total;
+	}
+}
+"@
+
+function Get-QuadReferenceStats([string]$prefix)
+{
+	$quadPath = $prefix + '-frozen.bmp'
+	if (-not (Test-Path -LiteralPath $quadPath)) { return $null }
+	$shares = @()
+	for ($view = 0; $view -lt 4; ++$view)
+	{
+		$referencePath = $prefix + '-ref' + $view + '.bmp'
+		if (-not (Test-Path -LiteralPath $referencePath)) { return $null }
+		$shares += [QuadReferenceCompare]::Compare($quadPath, $referencePath, $view, 52, 30, 8)
+	}
+	return $shares
+}
