+// Four-view reference pictures (stage QG): the four-view picture is taken with the world and the cameras frozen, then the game is switched to one
+// shared view and drawn four more times with each of the four cameras forced on the single full screen view. Each view of the four-view picture
+// has to be the same as the top left corner of the reference picture of its camera (the runner compares them, see "Get-QuadReferenceStats").
+function void QuadRef.step()
+{
+	++checks.refTick
+	if (checks.refPhase == 1)
+	{
+		if (checks.refTick == 4)
+		{
+			for (u8 view = 0; view < 4; ++view)
+			{
+				u16[0x8ffe00 + view * 4] = DropIn.partyViewCameraX(view)
+				u16[0x8ffe02 + view * 4] = DropIn.partyViewCameraY(view)
+			}
+		}
+		if (checks.refTick == 8)
+		{
+			Checks.report("frozen capture", Checks.capture("frozen"), "Engine framebuffer with the world and the cameras frozen")
+			Checks.report("quad cameras", 1, stringformat("P1 %04x,%04x P2 %04x,%04x P3 %04x,%04x", u16[0x8ffe00], u16[0x8ffe02], u16[0x8ffe04], u16[0x8ffe06], u16[0x8ffe08], u16[0x8ffe0a]))
+			Checks.report("quad cameras 2", 1, stringformat("P4 %04x,%04x screen %dx%d", u16[0x8ffe0c], u16[0x8ffe0e], getScreenWidth(), getScreenHeight()))
+			option.dropin.four_view_split = 0
+			checks.refPhase = 2
+			checks.refTick = 0
+			checks.refView = 0
+		}
+	}
+	else if (checks.refPhase == 2)
+	{
+		checks.refForce = true
+		checks.refForceX = u16[0x8ffe00 + checks.refView * 4]
+		checks.refForceY = u16[0x8ffe02 + checks.refView * 4]
+		if (checks.refTick == 8)
+			Checks.report("reference capture", Checks.capture(stringformat("ref%d", checks.refView)), stringformat("Game's own full screen picture of camera %d", checks.refView))
+		if (checks.refTick >= 9)
+		{
+			++checks.refView
+			checks.refTick = 0
+			if (checks.refView >= 4)
+			{
+				checks.refPhase = 3
+				checks.refForce = false
+				option.dropin.four_view_split = 1
+			}
+		}
+	}
+}
+
+function void UpdateCamera()
+{
+	if (QUAD_ACT_TEST && checks.refPhase == 1)
+		return			// The four cameras stand still while the four-view picture is taken
+	base.UpdateCamera()
+	if (QUAD_ACT_TEST && checks.refForce)
+	{
+		camera.position.x.u16 = checks.refForceX
+		camera.position.y.u16 = checks.refForceY
+	}
+}
+
+function void UpdateLevelDisplay()
+{
+	base.UpdateLevelDisplay()
+	if (QUAD_ACT_TEST && checks.refForce)
+		DropIn.restoreSingleViewPlanes()		// The camera jumped: build the whole single view from the game's level data, as the split screen does when it ends
+}
