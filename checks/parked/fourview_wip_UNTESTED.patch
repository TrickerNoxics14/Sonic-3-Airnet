diff --git a/DropInCoop/scripts/screensize.lemon b/DropInCoop/scripts/screensize.lemon
index 7c83434..1082df1 100644
--- a/DropInCoop/scripts/screensize.lemon
+++ b/DropInCoop/scripts/screensize.lemon
@@ -124,3 +124,17 @@ function void fn239e74()
 		return
 	base.fn239e74()
 }
+
+
+// Most zones fill the line scroll table (0xffffe000) with this function. It goes through a table of bands in the ROM that describes exactly 224 lines;
+// with a taller screen it asks for more lines than that and reads past the end of the table ("Invalid memory access at 0x400000" in IceCap 1 and
+// Mushroom Hill 1, where that table is the last data of the ROM; in other zones it silently reads other data). The views only show the first
+// lines of the table (at most 176), so asking for 224 lines is enough. Callers set "D1 = getScreenHeight() - 1" before: AIZ, HCZ, MGZ, CNZ, ICZ, LBZ,
+// MHZ, LRZ and more through "fn04f0ce", and some zones directly.
+//# address-hook(0x04f0de)
+function void fn04f0de()
+{
+	if (dropin.big_h != 0 && D1.u16 > 223)
+		D1.u16 = 223
+	base.fn04f0de()
+}
